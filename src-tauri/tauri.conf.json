{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lh-contributor-gui",
  "version": "0.1.0",
  "identifier": "app.landhunter.contributor-gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sync-version && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "LandHunter Contributor",
        "width": 360,
        "height": 480,
        "resizable": false,
        "minWidth": 360,
        "maxWidth": 360,
        "minHeight": 480,
        "maxHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utilities",
    "shortDescription": "LandHunter contributor tray app",
    "longDescription": "Tray app driving the LandHunter contributor run loop: choose chunk types, concurrency and a run window from the system tray; optional local-model grading via a sha256-pinned GGUF and a resource-capped llama-server sidecar.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
